{
  "name": "devpush-root",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "docs:check": "node scripts/validate-docs.mjs",
    "configure": "node scripts/setup.mjs",
    "secrets:pull": "node scripts/local-secrets.mjs",
    "dev": "pnpm --dir app dev",
    "dev:start": "scripts/local-start.sh",
    "dev:stop": "scripts/local-stop.sh",
    "dev:restart": "scripts/local-restart.sh",
    "build": "pnpm --dir app build",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "typecheck": "pnpm --dir app typecheck",
    "lint": "pnpm --dir app lint",
    "test": "pnpm --dir app test && node --test scripts/setup-config.test.mjs scripts/setup-hetzner.test.mjs scripts/local-stop.test.mjs scripts/local-secrets.test.mjs scripts/local-vm.test.mjs scripts/scheduler.test.mjs scripts/production-compose.test.mjs app/scripts/github-app.test.mjs scripts/agent-release.test.mjs scripts/validate-config.test.mjs scripts/validate-public-files.test.mjs",
    "test:integration": "pnpm --dir app test:integration",
    "smoke:deploy": "pnpm --dir app smoke:deploy",
    "smoke:node": "pnpm --dir app smoke:node",
    "smoke:dev": "pnpm --dir app smoke:dev",
    "smoke:agent": "GOCACHE=$PWD/.tmp/go-build-cache DEVPUSH_RUN_DOCKER_SMOKE=1 DEVPUSH_RUN_DOCKER_TESTS=1 go test ./agent/internal/agent -run 'TestRunDeploymentJob(RunsRealDockerCompose|RoutesThroughRealTraefik)|TestRestartRecoveryWithRealDocker|TestRestoreHelperDocker' -count=1 -v",
    "validate:local": "scripts/validate-local.sh",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:production": "scripts/validate-production-image.sh",
    "validate:remote": "scripts/validate-remote.sh",
    "validate:remote:proof": "scripts/validate-remote-proof.sh",
    "agent:build": "GOCACHE=$PWD/.tmp/go-build-cache node scripts/build-agent.mjs bin/devpush-agent",
    "agent:build:linux": "pnpm agent:build:linux:amd64 && pnpm agent:build:linux:arm64",
    "agent:build:linux:amd64": "GOCACHE=$PWD/.tmp/go-build-cache GOOS=linux GOARCH=amd64 node scripts/build-agent.mjs bin/devpush-agent-linux-amd64",
    "agent:build:linux:arm64": "GOCACHE=$PWD/.tmp/go-build-cache GOOS=linux GOARCH=arm64 node scripts/build-agent.mjs bin/devpush-agent-linux-arm64",
    "validate:cloudflare": "pnpm --dir app validate:cloudflare",
    "deploy:cloudflare": "pnpm --dir app validate:cloudflare:config && pnpm --dir app db:migrate:cloudflare && pnpm --dir app deploy:cloudflare:worker",
    "agent:test": "GOCACHE=$PWD/.tmp/go-build-cache go test ./agent/...",
    "setup:github-app": "node app/scripts/setup-github-app.mjs",
    "setup:hetzner": "node scripts/setup-hetzner.mjs",
    "vm:install": "scripts/local-vm.sh install",
    "vm:setup": "scripts/local-vm.sh setup",
    "vm:test": "scripts/local-vm.sh test",
    "vm:stop": "scripts/local-vm.sh stop",
    "vm:destroy": "scripts/local-vm.sh destroy",
    "cleanup:recover": "pnpm --dir app cleanup:recover",
    "test:package": "pnpm --dir app test:package",
    "agent:release:prepare": "GOCACHE=$PWD/.tmp/go-build-cache node scripts/agent-release.mjs",
    "agent:release:verify": "node scripts/verify-agent-release.mjs",
    "release:check": "node scripts/validate-public-files.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "jsonc-parser": "^3.3.1"
  },
  "pnpm": {
    "overrides": {
      "seroval": "1.6.9",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5",
      "browserslist": "4.28.7",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.9",
      "qs": "6.16.0",
      "minimatch>brace-expansion": "5.0.12",
      "xmlbuilder2>js-yaml": "4.3.2",
      "undici": "7.30.1"
    }
  }
}
