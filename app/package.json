{
  "name": "devpush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node -r ./scripts/fs-watch-error-guard.cjs ./node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 7429 --strictPort",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:cloudflare": "DEVPUSH_DEPLOY_TARGET=cloudflare vite build",
    "deploy:cloudflare:worker": "pnpm validate:cloudflare:config && pnpm build:cloudflare && wrangler deploy --config dist/server/wrangler.json --secrets-file \"${DEVPUSH_CLOUDFLARE_SECRETS_FILE:-.cloudflare-secrets.json}\"",
    "validate:cloudflare": "pnpm validate:cloudflare:config && pnpm build:cloudflare && wrangler deploy --config dist/server/wrangler.json --dry-run --secrets-file \"${DEVPUSH_CLOUDFLARE_SECRETS_FILE:-.cloudflare-secrets.json}\"",
    "validate:cloudflare:config": "tsx scripts/validate-cloudflare-config.mjs",
    "cf-typegen": "wrangler types --config wrangler.template.jsonc --env-file=cloudflare-types.env --include-runtime=false --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:migrate:cloudflare": "tsx scripts/migrate-cloudflare.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "storage:sync-agents": "tsx scripts/sync-agent-binaries.ts",
    "preview": "vite preview",
    "cleanup:invites": "tsx scripts/cleanup-expired-invites.ts",
    "cleanup:users": "tsx scripts/cleanup-deleted-users.ts",
    "smoke:deploy": "DEVPUSH_SMOKE_GITHUB_TOKEN=${DEVPUSH_SMOKE_GITHUB_TOKEN:-smoke-github-token} tsx scripts/smoke-deploy-lifecycle.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate:logs": "drizzle-kit generate --config drizzle.logs.config.ts",
    "test:integration:libsql": "DEVPUSH_TEST_LIBSQL=1 vitest run --config vitest.integration.config.ts",
    "smoke:worker": "node scripts/smoke-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@better-auth/drizzle-adapter": "~1.6.30",
    "@better-auth/utils": "0.4.2",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.48",
    "better-auth": "~1.6.30",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@3.0.1-20260821-005124-e36e7a60",
    "radix-ui": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.8.0",
    "resend": "^6.12.4",
    "safe-regex2": "5.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^10.9.1",
    "jsdom": "28.1.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.146.0",
    "ws": "^8.22.0"
  }
}
