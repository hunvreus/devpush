BETTER_AUTH_SECRET=replace-with-a-long-random-secret
DEVPUSH_BASE_URL=http://localhost:7429
# Optional Better Auth-only override. Defaults to DEVPUSH_BASE_URL.
BETTER_AUTH_URL=
# Optional bootstrap fallback: when blank, the earliest-created user is admin.
DEVPUSH_ADMIN_EMAIL=
DEVPUSH_DATABASE_PATH=.data/devpush.sqlite
DEVPUSH_LOG_DATABASE_PATH=.data/logs.sqlite
DEVPUSH_MONITORING_RETENTION_DAYS=7

EMAIL_FROM=devpush <onboarding@resend.dev>
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

DEVPUSH_AGENT_BINARY_DIR=
DEVPUSH_TRAEFIK_EMAIL=
DEVPUSH_AGENT_AUTO_UPDATE=false
DEVPUSH_BACKUPS_ENABLED=false
VITE_DEVPUSH_BACKUPS_ENABLED=false
DEVPUSH_CRON_SECRET=
DEVPUSH_SECRET_ENCRYPTION_KEY=dev-secret-encryption-key-change-me

# Optional remote libSQL/Turso. Set BOTH URLs to distinct databases; URLs override local paths.
DEVPUSH_DATABASE_URL=
DEVPUSH_DATABASE_AUTH_TOKEN=
DEVPUSH_LOG_DATABASE_URL=
DEVPUSH_LOG_DATABASE_AUTH_TOKEN=
