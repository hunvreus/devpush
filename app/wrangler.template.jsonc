{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devpush",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
}
