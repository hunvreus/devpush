# Generate every secret independently, for example with: openssl rand -base64 32
DEVPUSH_DATABASE_PATH=/app/storage/devpush.sqlite
DEVPUSH_LOG_DATABASE_PATH=/app/storage/logs.sqlite

BETTER_AUTH_SECRET=
DEVPUSH_SECRET_ENCRYPTION_KEY=
DEVPUSH_BASE_URL=https://devpush.example.com
# Set true only behind a reverse proxy that overwrites X-Real-IP or X-Forwarded-For.
DEVPUSH_TRUST_PROXY=false
DEVPUSH_CLIENT_IP_HEADER=x-forwarded-for
DEVPUSH_MONITORING_RETENTION_DAYS=7
# Optional Better Auth-only override. Defaults to DEVPUSH_BASE_URL.
BETTER_AUTH_URL=
# Optional full canonical public MCP endpoint; defaults to DEVPUSH_BASE_URL + /mcp.
DEVPUSH_MCP_URL=
# Set explicitly in production. Blank falls back to the earliest-created user.
DEVPUSH_ADMIN_EMAIL=admin@example.com
# Optional public notice on the sign-in page (plain text, up to 1,000 characters).
DEVPUSH_SIGN_IN_MESSAGE=

DEVPUSH_HTTP_PORT=7429
# Shared image for all services. Set a pinned tag/digest when using a prebuilt image.
DEVPUSH_PRODUCTION_IMAGE=devpush-app:local
DEVPUSH_TRAEFIK_EMAIL=ops@example.com
DEVPUSH_BACKUPS_ENABLED=false
DEVPUSH_AGENT_AUTO_UPDATE=false
DEVPUSH_RECOMMENDED_AGENT_VERSION=
DEVPUSH_CRON_SECRET=
DEVPUSH_DB_BACKUP_RETENTION_DAYS=7

EMAIL_FROM="devpush <noreply@example.com>"
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_NAME=devpush
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Optional S3-compatible object storage. Leave all blank to use app_uploads.
# For Cloudflare R2, use region=auto and the account-specific S3 endpoint.
DEVPUSH_STORAGE_ENDPOINT=
DEVPUSH_STORAGE_REGION=auto
DEVPUSH_STORAGE_BUCKET=
DEVPUSH_STORAGE_ACCESS_KEY_ID=
DEVPUSH_STORAGE_SECRET_ACCESS_KEY=

# Optional remote libSQL/Turso. Set BOTH URLs to distinct databases; URLs override local paths.
DEVPUSH_DATABASE_URL=
DEVPUSH_DATABASE_AUTH_TOKEN=
DEVPUSH_LOG_DATABASE_URL=
DEVPUSH_LOG_DATABASE_AUTH_TOKEN=
