POSTGRES_PASSWORD=replace-with-a-long-random-password

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
DEVPUSH_SECRET_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
BETTER_AUTH_URL=https://devpush.example.com

DEVPUSH_HTTP_PORT=7429
DEVPUSH_TRAEFIK_EMAIL=ops@example.com
DEVPUSH_BACKUPS_ENABLED=false
DEVPUSH_AGENT_AUTO_UPDATE=false
DEVPUSH_RECOMMENDED_AGENT_VERSION=
DEVPUSH_CRON_SECRET=replace-with-a-long-random-secret
DEVPUSH_DB_BACKUP_RETENTION_DAYS=7

EMAIL_FROM="devpush <noreply@example.com>"
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_NAME=devpush
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Optional S3-compatible object storage. Leave all blank to use app_uploads.
# For Cloudflare R2, use region=auto and the account-specific S3 endpoint.
DEVPUSH_STORAGE_ENDPOINT=
DEVPUSH_STORAGE_REGION=auto
DEVPUSH_STORAGE_BUCKET=
DEVPUSH_STORAGE_ACCESS_KEY_ID=
DEVPUSH_STORAGE_SECRET_ACCESS_KEY=
